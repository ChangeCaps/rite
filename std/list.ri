type [] a = [] | (:) a [a]

trait Fold t
  fold :: b -> (a -> b -> b) -> t a -> b

trait Sequence a
  len :: a -> int
  take :: int -> a -> a
  skip :: int -> a -> a

impl Fold ([])
  fold acc f xs = match xs
    x : xs -> fold (f x acc) f xs
    []     -> acc

impl Show [a] where a :: Show
  show xs =
    let xs = xs
      |> map show
      |> join '; '

    '[' + xs + ']'

impl Sequence [a]
  len xs = match xs
    _ : xs -> 1 + len xs
    []     -> 0

  take n xs = takeInto n xs []

  skip n xs = match n
    0 -> xs
    _ -> match xs
      x : xs -> skip (n - 1) xs
      [] -> []

append :: [a] -> [a] -> [a]
append xs ys = match xs
  x : xs -> x : append xs ys
  []     -> ys

takeInto n xs ys = match n
  0 -> ys
  _ -> match xs
    x : xs -> takeInto (n - 1) xs (x : ys)
    [] -> ys

join :: str -> [str] -> str
join sep ss = match ss
  []     -> ''
  s : [] -> s
  s : ss -> s + sep + join sep ss

any :: (a -> bool) -> [a] -> bool
any f xs = match xs
  x : xs -> match f x
    true -> true
    false -> any f xs
  [] -> false

all :: (a -> bool) -> [a] -> bool
all f xs = match xs
  x : xs -> match f x
    true -> all f xs
    false -> false
  [] -> true

sum :: t a -> a where t :: Fold where a :: Add + Zero
sum xs = fold zero (+) xs

sequence :: [m a] -> m [a] where m :: Monad
sequence ms = match ms
  [] -> pure []
  m : ms ->
    let x <- m
    let xs <- sequence ms
    pure (x : xs)

reverse :: [a] -> [a]
reverse xs = reverseInto xs []

reverseInto xs ys = match xs
  x : xs -> reverseInto xs (x : ys)
  [] -> ys
