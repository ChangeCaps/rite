type State s a = State (s -> a, s)

impl Monad State s
  (>>=) m f = State \s.
    let x, s = with m s
    with (f x) s

  pure x = State \s. x, s

impl Functor State s
  map f m = State \s.
    let x, s = with m s
    f x, s

with :: State s a -> s -> a, s
with (State f) s = f s

get :: State s s
get = State \s. s, s

set :: s -> State s ()
set s = State \_. (), s
