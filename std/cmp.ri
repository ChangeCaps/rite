trait Eq a
  (==) :: a -> a -> bool

trait Cmp a
  (>) :: a -> a -> bool
  (<) :: a -> a -> bool

not :: bool -> bool
not x = match x
  true -> false
  false -> true

(!=) :: a -> a -> bool where a :: Eq
(!=) x y = not (x == y)

(>=) :: a -> a -> bool where a :: Eq + Cmp
(>=) x y = x == y || x > y

(<=) :: a -> a -> bool where a :: Eq + Cmp
(<=) x y = x == y || x < y

max :: a -> a -> a where a :: Cmp
max x y = match x > y
  true  -> x
  false -> y

min :: a -> a -> a where a :: Cmp
min x y = match x < y
  true  -> x
  false -> y
