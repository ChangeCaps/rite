import 'std:map'

import 'intrinsic' as intrinsic

impl Add int
  (+) a b = intrinsic.intAdd a b

impl Sub int
  (-) a b = intrinsic.intSub a b

impl Mul int
  (*) a b = intrinsic.intMul a b

impl Div int
  (/) a b = intrinsic.intDiv a b

impl Zero int
  zero = 0

impl Default int
  default = 0

impl Eq int
  (==) a b = match a - b
    0 -> true
    _ -> false

impl Cmp int
  (>) a b = match intrinsic.intGt a b
    0 -> false
    _ -> true

  (<) a b = match intrinsic.intLt a b
    0 -> false
    _ -> true

impl Hash int
  hash x = x

impl Show int
  show x = intrinsic.intStr x
