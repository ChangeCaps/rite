type Maybe a = Some a | None

impl Functor Maybe
  map f x =
    match x
      Some x -> Some (f x)
      None -> None

impl Monad Maybe
  (>>=) m f =
    match m
      Some x -> f x
      None -> None

  pure = Some

impl Show Maybe a where a :: Show
  show x = match x
    Some x -> 'Some ' + show x
    None   -> 'None'

impl Eq Maybe a where a :: Eq
  (==) a b = match a, b
    Some a, Some b -> a == b
    None  , None   -> true
    _     , _      -> false

or ::  a -> Maybe a -> a
or y x = match x
  Some x -> x
  None -> y

isSome :: Maybe a -> bool
isSome x = match x
  Some _ -> true
  None   -> false

isNone :: Maybe a -> bool
isNone x = match x
  Some _ -> false
  None   -> true
