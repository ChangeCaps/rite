trait monad m :: * -> *
  (>>=) :: m a -> (a -> m b) -> m b
  pure :: a -> m a

(>>) :: m a -> m b -> m b where m :: monad
(>>) a b = a >>= \x. b

impl monad maybe
  (>>=) m f =
    match m
      some x -> f x
      none -> none

  pure x = some x

impl monad result e
  (>>=) m f =
    match m
      ok x -> f x
      err e -> err e

  pure x = ok x
