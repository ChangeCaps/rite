import 'std:state'

import 'rite:diagnostic/diagnostic'
import 'rite:rename/rename'
import 'rite:rename/expr'

type Env = Env {
  vals :: [Val]
}

type Val =
  | ValVar Var

impl Default Env
  default = Env {
    vals = []
  }

valName :: Val -> str
valName val = match val
  ValVar var -> name var

valSpan :: Val -> Span
valSpan val = match val
  ValVar var -> span var

addVal :: Val -> Env -> Env
addVal val env =
  env {
    vals = val : vals env
  }

findVal :: str -> Env -> Maybe Val
findVal name = vals
  \> firstWhere \v. valName v == name

resolveVal :: str -> Span -> Env -> Try str (State Rename) (Maybe Val)
resolveVal name span env =
  match findVal name env
    Some val -> pure (Some val)
    None -> 'undefined variable `' + name + '`'
      |> error
      |> label span 'here'
      |> fail
      >> pure None
