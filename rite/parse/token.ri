import 'rite:diagnostic/diagnostic'

type Tokens = Tokens [Token, Span] Span

impl Show Tokens
  show (Tokens ts eoi) = show ts

eoiSpan :: Tokens -> Span
eoiSpan (Tokens _ eoi) = eoi

nextToken :: Tokens -> Token, Span
nextToken (Tokens ts eoi) = match ts
  t : _ -> t
  [] -> Eoi, eoi

consumeToken :: Tokens -> Tokens
consumeToken (Tokens ts eoi) = match ts
  _ : ts -> Tokens ts eoi
  [] -> Tokens ts eoi

type Token =
  # literals

  | Str
  | Int
  | Real
  | Ident
  | Symbol
  | Comment

  # control

  | Unknown
  | Newline
  | Indent
  | Dedent
  | Eoi

impl Show Token
  show t = match t
    Str     -> '{str}'
    Int     -> '{int}'
    Real    -> '{real}'
    Ident   -> '{identifier}'
    Symbol  -> '{symbol}'
    Comment -> '{comment}'
    Unknown -> '{unknown}'
    Newline -> '{newline}'
    Indent  -> '{indent}'
    Dedent  -> '{dedent}'
    Eoi     -> '{end of input}'

impl Eq Token
  (==) a b = match a, b
    Str,     Str     -> true
    Int,     Int     -> true
    Real,    Real    -> true
    Ident,   Ident   -> true
    Symbol,  Symbol  -> true
    Comment, Comment -> true
    Unknown, Unknown -> true
    Newline, Newline -> true
    Indent,  Indent  -> true
    Dedent,  Dedent  -> true
    Eoi,     Eoi     -> true

    _ -> false
