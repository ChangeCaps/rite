import 'rite:diagnostic/diagnostic'
import 'rite:parse/parser'
import 'rite:parse/kind'

type Ty =
  | Var   VarTy   Span
  | Lam   LamTy   Span
  | Bin   BinTy   Span
  | App   AppTy   Span
  | List  ListTy  Span
  | Where WhereTy Span
  | Error         Span

type VarTy = VarTy {
  name :: str
}

type LamTy = LamTy {
  in  :: Ty
  out :: Ty
}

type BinTy = BinTy {
  op  :: str
  lhs :: Ty
  rhs :: Ty
}

type AppTy = AppTy {
  lam :: Ty
  arg :: Ty
}

type ListTy = ListTy {
  item :: Ty
}

type WhereTy = WhereTy {
  for  :: Ty
  in   :: Ty
  kind :: Kind
}

impl Show Ty
  show ty = match ty
    Var ty _ -> '(Var '
      + name ty + ')'

    Lam ty _ -> '(Lam '
      + show (in ty) + ' '
      + show (out ty) + ')'

    Bin ty _ -> '(Bin '
      + op ty + ' '
      + show (lhs ty) + ' '
      + show (rhs ty) + ')'

    App ty _ -> '(App '
      + show (lam ty) + ' '
      + show (arg ty) + ')'

    List ty _ -> '(List '
      + show (item ty) + ')'

    Where ty _ -> '(Where '
      + show (for ty) + ' '
      + show (in ty) + ')'

    Error _ -> 'Error'

tySpan :: Ty -> Span
tySpan ty  = match ty
  Var   _ span -> span
  Lam   _ span -> span
  Bin   _ span -> span
  App   _ span -> span
  List  _ span -> span
  Where _ span -> span
  Error   span -> span

parseTy :: Parser Ty
parseTy = parseWhereTy
  |> named '{type}'

parseWhereTy =
  let for <- parseLamTy

  let clauses <- many0 <|
    word 'where'
    let in <- recover Error parseLamTy
    symbol '::'
    let kind <- parseKindRecover
    pure (in, kind)

  clauses
    |> fold for \in, kind for.
      Where (WhereTy {
        for  = for
        in   = in
        kind = kind
      }) (tySpan for <> kindSpan kind)
    |> pure

parseLamTy =
  let in <- parseAppTy

  let lam =
    symbol '->'
    let out <- recover Error parseLamTy

    pure <| Lam (LamTy {
      in  = in
      out = out
    }) (tySpan in <> tySpan out)

  lam <|> pure in

parseAppTy =
  let lam <- parseTermTy
  let args <- many0  parseTermTy

  args
    |> fold lam \arg lam.
      App (AppTy {
        lam = lam
        arg = arg
      }) (tySpan lam <>  tySpan arg)
    |> pure

parseTermTy = parseVarTy

parseVarTy = spanned Var <|
  let name <- ident

  pure <| VarTy {
    name = name
  }

parseListTy =  spanned List <|
  let item <- recover Error parseTy

  pure <| ListTy {
    item = item
  }
