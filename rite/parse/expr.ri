import 'rite:diagnostic/diagnostic'
import 'rite:parse/parser'
import 'rite:parse/pat'

type Expr =
  | Lit   LitExpr Span
  | Var   VarExpr Span
  | Let   LetExpr Span
  | Lam   LamExpr Span
  | App   AppExpr Span
  | Seq   SeqExpr Span
  | Error Span

type LitExpr = LitExpr {
  lit :: Lit
}

type Lit = Int int

type VarExpr = VarExpr {
  name :: str
}

type LetExpr = LetExpr {
  in   :: Expr
  bind :: bool
  var  :: Pat
  out  :: Expr
}

type LamExpr = LamExpr {
  args :: [Pat]
  out  :: Expr
}

type AppExpr = AppExpr {
  lam :: Expr
  arg :: Expr
}

type SeqExpr = SeqExpr {
  lhs :: Expr
  rhs :: Expr
}

impl Show Lit
  show lit = match lit
    Int x -> show x

impl Show Expr
  show expr = match expr
    Lit expr _ -> '(Lit '
      + show (lit expr) + ')'

    Var expr _ -> '(Var '
      + name expr + ')'

    Let expr _ -> '(Let '
      + show (in expr) + ' '
      + show (var expr) + ' '
      + show (bind expr) + ' '
      + show (out expr) + ')'

    Lam expr _ -> '(Lam '
      + show (args expr) + ' '
      + show (out expr) + ')'

    App expr _ -> '(App '
      + show (lam expr) + ' '
      + show (arg expr) + ')'

    Seq expr _ -> '(Seq '
      + show (lhs expr) + ' '
      + show (rhs expr) + ')'

    Error _ -> 'Error'

exprSpan :: Expr -> Span
exprSpan expr = match expr
  Lit _ span -> span
  Var _ span -> span
  Let _ span -> span
  Lam _ span -> span
  App _ span -> span
  Seq _ span -> span
  Error span -> span

parseExprRecover :: Parser Expr
parseExprRecover = recover Error parseExpr

parseExpr :: Parser Expr
parseExpr = parseBlockExpr
  <|> parseAppExpr
  |> named '{expression}'

parseBlockExpr :: Parser Expr
parseBlockExpr =
  lines1
  indent

  let expr <- parseBlock

  lines0
  dedent

  pure expr

parseBlock :: Parser Expr
parseBlock = parseLetExpr <|> parseSeqExpr

parseLetExpr :: Parser Expr
parseLetExpr = spanned Let <|
  word 'let'

  let var <- parsePat

  let bind <- (symbol '=' >> pure false)
    <|> (symbol '<-' >> pure true)

  let in <- recover Error parseExpr

  lines1

  let out <- recover Error parseBlock

  pure <| LetExpr {
    in   = in
    bind = bind
    var  = var
    out  = out
  }

parseSeqExpr :: Parser Expr
parseSeqExpr =
  let lhs <- parseExpr
  lines0
  let rhs <- maybe parseBlock

  rhs
    |> map \rhs.
      Seq (SeqExpr {
        lhs = lhs
        rhs = rhs
      }) (exprSpan lhs <> exprSpan rhs)
    |> or lhs
    |> pure

parseAppExpr :: Parser Expr
parseAppExpr =
  let lam <- parseTermExpr
  let args <- many0 parseTermExpr

  args
    |> fold lam \arg lam.
      App (AppExpr {
        lam = lam
        arg = arg
      }) (exprSpan lam <> exprSpan arg)
    |> pure

parseTermExpr :: Parser Expr
parseTermExpr = parseIntExpr
  <|> parseVarExpr
  <|> parseLamExpr

parseIntExpr :: Parser Expr
parseIntExpr = spanned Lit <|
  let x <- int

  pure <| LitExpr {
    lit = Int x
  }

parseVarExpr :: Parser Expr
parseVarExpr = spanned Var <|
  let name <- ident

  pure <| VarExpr {
    name = name
  }

parseLamExpr :: Parser Expr
parseLamExpr = spanned Lam <|
  symbol '\\'
  let args <- many1 parsePat
  symbol '.'
  let out <- recover Error parseExpr

  pure <| LamExpr {
    args = args
    out  = out
  }
