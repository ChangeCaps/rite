import 'rite:diagnostic/diagnostic'
import 'rite:parse/token'

type Lexer = Lexer {
  input  :: Source
  offset :: int
  indent :: [str]
  tokens :: [Token, Span]
  report :: Report
}

impl Reporter State Lexer ()
  mapReport f =
    let lexer <- get
    set <| lexer { report = f (report lexer) }

lex :: Source -> [Token, Span], Report
lex input =
  let _, lexer = Lexer {
    input  = input
    offset = 0
    indent = []
    tokens = []
    report = default
  } |> with run

  tokens lexer, report lexer

run :: State Lexer ()
run =
  let isEoi <- isEoi
  match isEoi
    false -> line >> run
    true ->
      let span <- consume
      let lexer <- get
      addDedents (len (indent lexer)) span

line :: State Lexer ()
line =
  let ws <- whitespace
  let lexer <- get
  indents (indent lexer |> reverse) (spanStr ws) ws
  lineTokens
  let span <- consume
  addToken (Newline, span)

indents :: [str] -> str -> Span -> State Lexer ()
indents xs ws span = match xs
  x : xs' -> match ws
    '' -> addDedents (len xs) span
    _ -> match startsWith x ws
      true -> indents xs' (skip (len x) ws) span
      false -> error 'invalid indentation'
        |> label span 'found here'
        |> fail

  [] -> match ws
    '' -> pure ()
    _  ->
      addToken (Indent, span)
      addIndent ws

# Add `n` dedentations to lexer
addDedents :: int -> Span -> State Lexer ()
addDedents n span =
  addToken (Dedent, span)
    >> addToken (Newline, span)
    |> repeat n

  let lexer <- get
  set <| lexer { indent = skip n (indent lexer) }

lineTokens :: State Lexer ()
lineTokens =
  whitespace
  let c <- peek
  match c
    '\n' -> pure ()
    ''   -> pure ()
    _    -> token >> lineTokens

token :: State Lexer ()
token =
  let result <- ident
    | symbol
    | delimiter

  match result
    Some token ->
      addToken token

    None ->
      let span <- consume
      addToken (Unknown, span)

(|) :: State Lexer (Maybe (Token, Span)) -> State Lexer (Maybe (Token, Span)) -> State Lexer (Maybe (Token, Span))
(|) b a =
  let result <- a
  match result
    Some _ -> pure result
    None   -> b

# Lex whitespace
whitespace :: State Lexer Span
whitespace = consumeWhile isWhitespace

# Lex an identifier
ident :: State Lexer (Maybe (Token, Span))
ident =
  let c <- peek
  match isIdentStart c
    false -> pure None
    true ->
      let span <- consumeWhile isIdentContinue

      match start span == end span
        true -> pure None
        false -> pure (Some (Symbol, span))

# Lex a symbol
symbol :: State Lexer (Maybe (Token, Span))
symbol =
  let c <- peek
  match isSymbolic c
    false -> pure None
    true ->
      let span <- consumeWhile isSymbolic

      match start span == end span
        true -> pure None
        false -> pure (Some (Symbol, span))

delimiter :: State Lexer (Maybe (Token, Span))
delimiter =
  let c <- peek
  match isDelimiter c
    false -> pure None
    true ->
      let span <- consume
      pure (Some (Symbol, span))

# Check if character is whitespace
isWhitespace :: str -> bool
isWhitespace c = c == ' ' || c == '\t'

# Check if character is a valid start of an identifier
isIdentStart :: str -> bool
isIdentStart c = isAlphabetic c

# Check if character is a valid continuation of an identifier
isIdentContinue :: str -> bool
isIdentContinue c = isAlphabetic c || isNumeric c || c == '-' || c == '\''

# Check if character is alphabetic
isAlphabetic :: str -> bool
isAlphabetic c =
  let alphabet = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'
  has c alphabet

# Check if character is numeric
isNumeric :: str -> bool
isNumeric c =
  let numbers = '0123456789'
  has c numbers

# Check if character is a valid symbol
isSymbolic :: str -> bool
isSymbolic c =
  let symbols = '=+-*><\\/|&$%~!@^'
  has c symbols

isDelimiter :: str -> bool
isDelimiter c =
  let delimiters = '()[]{}'
  has c delimiters

# Consume characters while predicate is true
consumeWhile :: (str -> bool) -> State Lexer Span
consumeWhile f =
  let c <- peek

  match f c && c != '\n'
    true ->
      let len <- advance
      let span <- consumeWhile f

      pure <| span { start = start span - len }

    false ->
      let lexer <- get

      pure <| Span {
        source = input lexer
        start  = offset lexer
        end    = offset lexer
      }

consume :: State Lexer Span
consume =
  let lexer <- get
  let length <- advance

  pure (Span {
    source = input lexer
    start  = offset lexer
    end    = offset lexer + length
  })

# Advance the lexer by one character
advance :: State Lexer int
advance =
  let c <- peek
  let lexer <- get

  set <| lexer { offset = offset lexer + len c }
  pure <| len c

# Check if the lexer is at the end of input
isEoi :: State Lexer bool
isEoi =
  let lexer <- get
  pure (lexer |> input |> contents |> len == offset lexer)

# Prepend a token to the lexer
addToken :: Token, Span -> State Lexer ()
addToken token =
  let lexer <- get
  set (lexer { tokens = token : tokens lexer })

# Prepend an indentation to the lexer
addIndent :: str -> State Lexer ()
addIndent id =
  let lexer <- get
  set (lexer { indent = id : indent lexer })

# Get the next character
peek :: State Lexer str
peek =
  let lexer <- get

  let offset = lexer |> offset
  let contents = lexer |> input |> contents

  pure <| char offset contents
