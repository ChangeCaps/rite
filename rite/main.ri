import 'std:fs'

import 'rite:diagnostic/diagnostic'
import 'rite:diagnostic/format'
import 'rite:parse/lex'
import 'rite:parse/parser'
import 'rite:parse/token'
import 'rite:parse/stmt'

main :: io ()
main =
  let result <- unwrap read
  print (show result)

read :: Try io IoError ()
read =
  let contents <- try <| readFile 'test.ri'

  let source = Source {
    path     = 'test.ri'
    contents = contents
  }

  let ts, lexReport = lex source
  let expr, parseReport = runParser parseStmts ts

  lexReport <> parseReport
    |> formatReport
    |> println
    |> lift

  expr
    |> show
    |> println
    |> lift

  pure ()
