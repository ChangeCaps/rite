import 'std:fs'

import 'rite:diagnostic/diagnostic'
import 'rite:diagnostic/format'
import 'rite:parse/lex'
import 'rite:parse/parser'
import 'rite:parse/token'
import 'rite:parse/expr'

main :: io ()
main =
  let result <- unwrap read
  print (show result)

read :: Try io IoError ()
read =
  let contents <- try <| readFile 'test.ri'

  let source = Source {
    path     = 'test.ri'
    contents = contents
  }

  let ts, report = lex source

  let result = expr
    |> runParser ts

  match result
    Some (_, report) ->
      report
        |> formatReport
        |> println
        |> lift
    None -> pure ()

  pure ()
