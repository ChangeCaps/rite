import 'std:fs'

import 'rite:diagnostic/diagnostic'
import 'rite:diagnostic/format'
import 'rite:parse/lex'
import 'rite:parse/module'
import 'rite:rename/rename'

main :: io ()
main =
  let result <- unwrap read
  print (show result)

read :: Try IoError io ()
read =
  let contents <- try <| readFile 'test.ri'

  let source = Source {
    path     = 'test.ri'
    contents = contents
  }

  let ts, lexReport = lex source
  let module, parseReport = parseModule 'test.ri' ts

  match rename [module]
    Err err -> lift <| println ('internal error: ' + err)
    Ok (unit, renameReport) ->
      lexReport <> parseReport <> renameReport
        |> formatReport
        |> println
        |> lift

      module
        |> show
        |> println
        |> lift
